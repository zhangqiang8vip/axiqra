# === Frontend (axiqra-app) is a separate independent repository ===
# Source lives at axiqra-project/axiqra-app with its own .git; commit there, not here.
# We only ignore the runtime/build artifacts (node_modules, dist, tsbuildinfo, .env.*).
axiqra-project/axiqra-app/node_modules/
axiqra-project/axiqra-app/dist/
axiqra-project/axiqra-app/*.tsbuildinfo
axiqra-project/axiqra-app/.env
axiqra-project/axiqra-app/.env.local
axiqra-project/axiqra-app/.env.*.local
# The frontend repo's own .git and .env.example are managed inside axiqra-app/
# and intentionally left untracked from the parent repository.

