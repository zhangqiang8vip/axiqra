name: GitHub Copilot Review

on:
  pull_request:
    types: [opened, synchronize, reopened]
    paths:
      - ".gitignore"
      - "docs/**"
      - "axiqra-project/**"
      - "tests/**"
      - ".github/workflows/*.yml"
      - ".github/scripts/**"
      - "*.mjs"
      - "*.js"
      - "*.py"
      - "*.java"
      - "*.xml"
      - "*.yml"
      - "*.yaml"
      - "*.sql"
      - "Dockerfile*"
  workflow_dispatch:
    inputs:
      pr_number:
        description: "PR Number to review"
        required: false
        type: string

jobs:
  copilot-review:
    name: GitHub Copilot Code Review
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      contents: read
      checks: write
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Get PR diff
        id: diff
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number || github.event.inputs.pr_number }}
        run: |
          if [ -n "$PR_NUMBER" ]; then
            gh pr diff $PR_NUMBER > pr_changes.diff
            echo "diff_size=$(wc -l < pr_changes.diff)" >> $GITHUB_OUTPUT
          fi

      - name: Get changed files list
        id: files
        run: |
          if [ -f pr_changes.diff ]; then
            echo "files<<EOF" >> $GITHUB_OUTPUT
            grep "^diff --git" pr_changes.diff | awk '{print $3}' | sed 's/^b\///' | sort | uniq >> $GITHUB_OUTPUT
            echo "EOF" >> $GITHUB_OUTPUT
          fi

      - name: Post Copilot Review
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const fs = require('fs');
            const { generateReviewBody } = await import('./.github/scripts/copilot-review-body.mjs');
            const diff = fs.readFileSync('pr_changes.diff', 'utf8');
            const diffLines = diff.split('\n');
            const diffSize = diffLines.length;

            const copilotInstructions = fs.existsSync('.github/copilot-instructions.md')
              ? fs.readFileSync('.github/copilot-instructions.md', 'utf8')
              : '';

            const changedFiles = diff.match(/diff --git a\/(.*?) b\//g) || [];
            const filesList = changedFiles.map(f => f.replace('diff --git a/', '').replace(' b/', ''));

            const securityRisks = [];
            const mcpChanges = [];
            const testChanges = [];
            const apiChanges = [];

            filesList.forEach(file => {
              if (file.includes('mcp') || file.includes('MCP')) mcpChanges.push(file);
              if (file.includes('test') || file.includes('fixture')) testChanges.push(file);
              if (file.includes('audit') || file.includes('policy') || file.includes('redaction')) securityRisks.push(file);
              if (file.includes('api-adapter') || file.includes('search-service')) apiChanges.push(file);
            });

            const reviewBody = generateReviewBody(
              mcpChanges,
              testChanges,
              securityRisks,
              apiChanges,
              filesList,
              diffSize,
              context
            );

            const prNumber = context.payload.pull_request?.number;
            if (prNumber) {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: prNumber,
                body: reviewBody
              });
            } else {
              console.warn('No pull_request context; skipping issue comment.');
            }

            if (context.payload.pull_request?.head?.sha) {
              await github.rest.checks.runs.create({
                owner: context.repo.owner,
                repo: context.repo.repo,
                name: 'Copilot Code Review',
                head_sha: context.payload.pull_request.head.sha,
                status: 'completed',
                conclusion: 'action_required',
                output: {
                  title: 'Copilot Code Review',
                  summary: `审查了 ${filesList.length} 个文件，共 ${diffSize} 行变更`,
                  text: reviewBody
                }
              });
            } else {
              console.warn('No pull_request head SHA; skipping check run creation.');
            }
