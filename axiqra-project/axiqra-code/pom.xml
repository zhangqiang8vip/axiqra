<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         Axiqra S1 后端 — Maven 多模块项目
         严格遵循阿里巴巴 Java 开发手册（嵩山版 1.7.x）
         ============================================================ -->
    <groupId>com.axiqra</groupId>
    <artifactId>axiqra-code</artifactId>
    <version>1.0.0-S1</version>
    <packaging>pom</packaging>
    <name>Axiqra Code</name>
    <description>Axiqra S1 后端服务 — Spring Boot + MyBatis-Flex + CockroachDB</description>
    <url>https://www.axiqra.com</url>

    <!-- ============ 项目属性 ============ -->
    <properties>
        <!-- 字符编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JDK 17+ (Spring Boot 3.5.x 要求) -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Spring Boot 3.5.x -->
        <spring-boot.version>3.5.14</spring-boot.version>
        <!-- Spring Security（由 dependencyManagement 显式管理版本，Spring Boot 3.5.x 依赖 6.5.x 系列） -->
        <spring-security.version>6.5.2</spring-security.version>
        <!-- 核心依赖版本（与 Spring Boot BOM 一致） -->
        <mybatis-flex.version>1.11.7</mybatis-flex.version>
        <sa-token.version>1.42.0</sa-token.version>
        <hutool.version>5.8.30</hutool.version>
        <springdoc-openapi.version>2.8.17</springdoc-openapi.version>
        <druid.version>1.2.28</druid.version>
        <shardingsphere.version>5.5.3</shardingsphere.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <snakeyaml.version>2.6</snakeyaml.version>
        <flyway.version>12.9.0</flyway.version>
        <!-- Micrometer Prometheus registry (与 Spring Boot 3.5.x BOM 对齐的独立版本号) -->
        <micrometer-prometheus.version>1.14.10</micrometer-prometheus.version>
        <!-- MinIO 对象存储 -->
        <minio.version>8.5.9</minio.version>
        <!-- 测试 -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <mockito.version>5.15.2</mockito.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- 构建 -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
        <!-- 默认 false：S1 跳过 jacoco report-aggregate 的子模块绑定，由根模块 verify 阶段聚合执行。
             设为 true 可在 CI 阶段临时跳过聚合，仅保留单模块报告。 -->
        <jacoco.report.skip>false</jacoco.report.skip>
        <lombok.version>1.18.46</lombok.version>
        <javadoc.io.tarball.url>https://central.sonatype.com</javadoc.io.tarball.url>
    </properties>

    <!-- ============ 依赖版本管理（单点管理，防止冲突） ============ -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖 BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Flex -->
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-core</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-processor</artifactId>
                <version>${mybatis-flex.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Sa-Token（权限认证 + Redis 分布式会话） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- Springdoc OpenAPI（API 文档，Spring Boot 3.5.x 使用 2.8.x 线） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- Druid 连接池 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- Spring Security Crypto（BCrypt 密码哈希，由 Spring Boot BOM 管理版本） -->
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-crypto</artifactId>
                <version>${spring-security.version}</version>
            </dependency>

            <!-- Apache ShardingSphere（读写分离/分库分表） -->
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>

            <!-- Resilience4j（熔断降级） -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-ratelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-timelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Micrometer Prometheus registry（暴露 /actuator/prometheus） -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>${micrometer-prometheus.version}</version>
            </dependency>

            <!-- Flyway（数据库版本化管理，审计库 PostgreSQL） -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- MinIO 对象存储 -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- 测试：TestContainers（容器化数据库测试） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>cockroachdb</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- 测试：Mockito -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- 测试：ArchUnit（架构测试） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============ 全局构建配置 ============ -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Java 编译器 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>UTF-8</encoding>
                        <!-- 阿里规范：-parameters 保留方法参数名 -->
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.mybatis-flex</groupId>
                                <artifactId>mybatis-flex-processor</artifactId>
                                <version>${mybatis-flex.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!-- Surefire 测试 -->
<plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*E2ETest.java</exclude>
                    </excludes>
                    <!-- JaCoCo prepare-agent 设置的 argLine 必须被 surefire 引用 -->
                    <argLine>@{argLine}</argLine>
                </configuration>
            </plugin>
                <!-- JaCoCo 覆盖率：已挪至下方 <plugins> 实际激活区 -->
                <!-- Spring Boot 打包插件 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <!-- Flyway Maven 插件（用于数据库迁移） -->
                <plugin>
                    <groupId>org.flywaydb</groupId>
                    <artifactId>flyway-maven-plugin</artifactId>
                    <version>${flyway.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 强制使用 JDK 17，避免本机 Maven 落到 JDK 8 后出现不可重复的编译问题 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-java-version</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,18)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- 根模块的 jacoco aggregate 通过 -Pcoverage 触发；详见底部 profile 配置。 -->
            <!-- JaCoCo：在父 POM 显式激活，使所有子模块都能 attach 到 surefire 并生成覆盖率数据 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <!-- prepare-agent 必须让每个子模块都执行，把 javaagent 注入 surefire -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 单模块 report：在 test 阶段基于本模块 jacoco.exec 输出 csv/html/xml -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              report-aggregate 不在 pluginManagement 配置，原因：
              jacoco-maven-plugin 0.8.13 默认将 report-aggregate 绑到 verify 阶段，
              子模块各自 verify 时只能看到自己一个 exec，导致聚合数据不全。
              正确做法：在根模块 <plugins> 块显式声明（不在子模块触发），
              根模块 verify 阶段一次性读取所有子模块 target/jacoco.exec。
            -->
            <!--
              S1 MVP 暂不在本地 verify 阶段强制覆盖率阈值：
              - jacoco-maven-plugin 0.8.13 起，report-aggregate 已在根模块 verify 阶段聚合，
                多模块报告与单模块报告对齐。
              - S1.5 恢复 bundle-level 阈值校验（建议 LINE 50% / BRANCH 25%）。
              - report-aggregate 由 -Pcoverage profile 触发，profile 内对根模块 jacoco
                显式添加 execution，子模块不继承。
            -->
        </plugins>
    </build>

    <!-- ============ 模块定义 ============ -->
    <modules>
        <!-- 通用层：DO/DTO/VO/枚举/异常/工具类 -->
        <module>axiqra-common</module>
        <!-- 核心业务层：Mapper + Service -->
        <module>axiqra-core</module>
        <!-- API 层：Controller + 配置 + 安全 -->
        <module>axiqra-api</module>
        <!-- 启动模块：主类 + 资源配置 + Dockerfile -->
        <module>axiqra-start</module>
        <!-- 代码生成器（可选） -->
        <module>axiqra-generator</module>
    </modules>

    <!--
      ============ Profile：coverage ============
      用法：mvn -Pcoverage clean verify
      行为：在 verify 阶段额外执行 jacoco:report-aggregate，输出 target/site/jacoco-aggregate/
            包含 index.html + jacoco.csv + jacoco.xml，便于 CI 抓取。
      不加 -Pcoverage 时：每个子模块各自生成 target/site/jacoco/，不聚合。
    -->
    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>aggregate-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
