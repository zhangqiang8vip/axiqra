              }
            ],
            "url": {
              "raw": "{{baseurl}}/traces",
              "host": [
                "{{baseurl}}/traces"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"projectId\": 1001,\n  \"taskGoal\": \"AI Agent 接入 Axiqra 后执行任务前搜索并回传工程轨迹\",\n  \"toolType\": \"codex\",\n  \"contextSnapshot\": \"{\\\"source\\\":\\\"postman\\\",\\\"flow\\\":\\\"mvp-aiagent\\\"}\",\n  \"forwardSteps\": \"[\\\"创建个人空间\\\",\\\"创建接入会话\\\",\\\"执行 search_before_act\\\",\\\"提交 trace\\\"]\",\n  \"reversePath\": \"[\\\"doctor 失败时检查 token\\\",\\\"搜索无命中时保留候选路径\\\"]\",\n  \"decisions\": \"[{\\\"decision\\\":\\\"使用个人 workspace\\\",\\\"reason\\\":\\\"MVP 不依赖团队空间\\\"}]\",\n  \"rollbackPath\": \"[\\\"撤销本次接入会话\\\",\\\"删除测试空间\\\"]\",\n  \"outcome\": \"AI Agent 接入闭环可验证\",\n  \"riskLevel\": \"R1\",\n  \"visibilityScope\": \"workspace\",\n  \"evolutionSuggestion\": \"生成工程方案 Solution\",\n  \"idempotencyKey\": \"mvp-trace-{{runId}}\",\n  \"evidences\": [\n    {\n      \"uri\": \"postman://mvp-aiagent/{{runId}}\",\n      \"hash\": \"sha256-mvp-{{runId}}\",\n      \"type\": \"postman_run\",\n      \"sizeBytes\": 256\n    }\n  ]\n}",
              "options": {
