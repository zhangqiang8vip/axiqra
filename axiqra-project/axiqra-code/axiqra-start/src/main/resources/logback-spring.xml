<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
    <!-- ===================== 全局属性 ===================== -->
    <springProperty scope="context" name="APP_NAME"  source="spring.application.name"   defaultValue="axiqra-core"/>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path"         defaultValue="/var/log/axiqra"/>

    <contextName>${APP_NAME}</contextName>

    <!-- ===================== 日志格式 ===================== -->
    <!--
        格式说明：
        %d{yyyy-MM-dd HH:mm:ss.SSS}  - 时间戳（毫秒精度）
        %highlight(%-5level)          - 日志级别（高亮颜色区分）
        [%X{traceId:-N/A}]            - traceId（从 MDC 读取，不存在显示 N/A）
        [%X{userId:-N/A}]            - userId（从 MDC 读取，不存在显示 N/A）
        [%thread]                     - 线程名
        %-40logger{36}               - Logger 名（最多36字符，左对齐）
        %msg%n                        - 消息 + 换行
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:-N/A}] [%X{userId:-N/A}] [%thread] %-40logger{36} - %msg%n"/>

    <property name="LOG_PATTERN_SIMPLE"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-N/A}] [%thread] %-40logger{36} - %msg%n"/>

    <!-- ===================== 控制台输出（Docker logs 可看） ===================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===================== 基础文件 Appender（由 ASYNC 包装） ===================== -->

    <!-- Info 日志：每日滚动，保留 30 天，最大 100MB/文件 -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-info.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN_SIMPLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-info.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Warn 日志：每日滚动，保留 30 天 -->
    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-warn.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN_SIMPLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-warn.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Error 日志：每日滚动，保留 90 天（含 FATAL） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN_SIMPLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ===================== 异步包装器（不阻塞业务线程） ===================== -->
    <!--
        配置说明：
        - queueSize: 阻塞队列大小（512）
        - discardingThreshold: 0 = 队列满时拒绝所有新日志（不阻塞），默认 -1 则仅丢弃 INFO 以下
        - includeCallerData: false = 不捕获调用位置（性能优化）
        - neverBlock: true = 队列满时不阻塞，直接丢弃事件；neverBlock=false = 队列满时阻塞等待（保证送达）
        注意：ASYNC_ERROR 设置 neverBlock=false，确保 ERROR 级别日志不被丢弃
    -->
    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <appender name="ASYNC_WARN" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>true</neverBlock>
        <appender-ref ref="WARN_FILE"/>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <neverBlock>false</neverBlock>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <!-- ===================== 日志级别配置 ===================== -->
    <!-- 第三方库日志级别（按 plan 规范） -->
    <logger name="com.axiqra"          level="INFO"/>
    <logger name="org.springframework"  level="WARN"/>
    <logger name="org.apache.shardingsphere" level="WARN"/>
    <logger name="com.mybatisflex"     level="WARN"/>
    <logger name="org.apache.http"     level="WARN"/>
    <logger name="io.lettuce"          level="WARN"/>
    <logger name="io.netty"            level="WARN"/>
    <logger name="org.hibernate"       level="WARN"/>
    <logger name="org.mybatis"         level="WARN"/>
    <logger name="com.zaxxer.hikari"   level="WARN"/>
    <logger name="org.postgresql"      level="WARN"/>

    <!-- ===================== 根 Logger（同时输出到控制台和文件） ===================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_WARN"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </root>

</configuration>
