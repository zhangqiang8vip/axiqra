    {
      "name": "03 工程轨迹回传到 Project Case",
      "item": [
        {
          "name": "AI Agent 提交 Trace 草稿",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function rawLong(field) {",
                  "  const raw = pm.response.text();",
                  "  const re = new RegExp('\"' + field + '\"\\\\s*:\\\\s*\"?([0-9]+)\"?');",
                  "  const match = raw.match(re);",
                  "  return match ? match[1] : undefined;",
                  "}",
                  "pm.test('状态码为 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('包含 requestId', function () { pm.expect(body.requestId).to.be.ok; });",
                  "const traceId = rawLong('id') || rawLong('traceId');",
                  "pm.environment.set('traceId', traceId);",
                  "pm.test('Trace ID 存在', function () { pm.expect(traceId).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
