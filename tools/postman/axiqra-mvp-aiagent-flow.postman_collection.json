{
  "info": {
    "name": "Axiqra MVP：个人空间 AI Agent 接入到工程方案闭环",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "验证 S1 MVP 主链路：个人用户创建个人工作空间，AI Agent 接入，任务前搜索，回传 Engineering Trace，生成 Project Case，再生成 AI 可调用的 Solution，并记录 Invocation/Feedback。"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('baseurl')) {",
          "  throw new Error('baseurl 未设置：请选择 Axiqra 本地 API 环境，或设置为 http://localhost:8080/api');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 初始化与连通",
      "item": [
        {
          "name": "初始化本轮 MVP 变量",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.environment.set('runId', String(runId));",
                  "pm.environment.set('registerUsername', 'mvp_owner_' + runId);",
                  "pm.environment.set('registerEmail', 'mvp_owner_' + runId + '@example.test');",
                  "pm.environment.set('registerPassword', 'AxIqra@123456');",
                  "pm.environment.set('workspaceName', 'Axiqra MVP 个人空间 ' + runId);",
                  "pm.environment.unset('authToken');",
                  "pm.environment.unset('userId');",
                  "pm.environment.unset('workspaceId');",
                  "pm.environment.unset('secondWorkspaceId');",
                  "pm.environment.unset('connectSessionId');",
                  "pm.environment.unset('traceId');",
                  "pm.environment.unset('projectCaseId');",
                  "pm.environment.unset('solutionId');",
                  "pm.environment.unset('invocationId');",
                  "pm.test('状态码为 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('健康状态为 UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/internal/health",
              "host": [
                "{{baseurl}}/internal/health"
              ]
            }
          }
        },
        {
          "name": "OpenAPI 文档公开访问",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('返回 OpenAPI 文档', function () { pm.expect(pm.response.json().openapi).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/v3/api-docs",
              "host": [
                "{{baseurl}}/v3/api-docs"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 个人用户与个人空间",
      "item": [
        {
          "name": "注册个人用户并保存 Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function rawLong(field) {",
                  "  const raw = pm.response.text();",
                  "  const re = new RegExp('\"' + field + '\"\\\\s*:\\\\s*\"?([0-9]+)\"?');",
                  "  const match = raw.match(re);",
                  "  return match ? match[1] : undefined;",
                  "}",
                  "pm.test('状态码为 200 或 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('包含 requestId', function () { pm.expect(body.requestId).to.be.ok; });",
                  "pm.test('Token 存在', function () { pm.expect(body.data.token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('authToken', body.data.token);",
                  "const userId = rawLong('userId') || rawLong('id');",
                  "pm.environment.set('userId', userId);",
                  "pm.test('用户 ID 存在', function () { pm.expect(userId).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/auth/register",
              "host": [
                "{{baseurl}}/auth/register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"nickname\": \"MVP 个人开发者\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "创建个人工作空间",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function rawLong(field) {",
                  "  const raw = pm.response.text();",
                  "  const re = new RegExp('\"' + field + '\"\\\\s*:\\\\s*\"?([0-9]+)\"?');",
                  "  const match = raw.match(re);",
                  "  return match ? match[1] : undefined;",
                  "}",
                  "pm.test('状态码为 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('工作空间类型为 personal', function () { pm.expect(String(body.data.workspaceType).toLowerCase()).to.eql('personal'); });",
                  "const workspaceId = rawLong('id') || rawLong('workspaceId');",
                  "pm.environment.set('workspaceId', workspaceId);",
                  "pm.test('个人 workspaceId 存在', function () { pm.expect(workspaceId).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/workspaces",
              "host": [
                "{{baseurl}}/workspaces"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceType\": \"personal\",\n  \"workspaceName\": \"{{workspaceName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "确认个人空间详情",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('包含 requestId', function () { pm.expect(body.requestId).to.be.ok; });",
                  "pm.test('当前用户是 owner', function () { pm.expect(pm.response.json().data.myRole).to.eql('owner'); });",
                  "pm.test('仍是个人空间', function () { pm.expect(String(pm.response.json().data.workspaceType).toLowerCase()).to.eql('personal'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/workspaces/{{workspaceId}}",
              "host": [
                "{{baseurl}}/workspaces/{{workspaceId}}"
              ]
            }
          }
        },
        {
          "name": "创建第二工作空间验证多空间并存",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function rawLong(field) {",
                  "  const raw = pm.response.text();",
                  "  const re = new RegExp('\"' + field + '\"\\\\s*:\\\\s*\"?([0-9]+)\"?');",
                  "  const match = raw.match(re);",
                  "  return match ? match[1] : undefined;",
                  "}",
                  "pm.test('状态码为 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('第二空间类型为 team', function () { pm.expect(String(body.data.workspaceType).toLowerCase()).to.eql('team'); });",
                  "const secondWorkspaceId = rawLong('id') || rawLong('workspaceId');",
                  "pm.environment.set('secondWorkspaceId', secondWorkspaceId);",
                  "pm.test('第二 workspaceId 存在', function () { pm.expect(secondWorkspaceId).to.be.a('string').and.not.empty; });",
                  "pm.test('第二空间不覆盖个人空间', function () { pm.expect(secondWorkspaceId).to.not.eql(pm.environment.get('workspaceId')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/workspaces",
              "host": [
                "{{baseurl}}/workspaces"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceType\": \"team\",\n  \"workspaceName\": \"Axiqra MVP 第二空间 {{runId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "列出我的空间应同时包含多个空间",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function containsId(items, id) {",
                  "  return items.some(function (item) { return String(item.id) === String(id); });",
                  "}",
                  "pm.test('状态码为 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('包含 requestId', function () { pm.expect(body.requestId).to.be.ok; });",
                  "const records = body.data.records || body.data.list || body.data.items || [];",
                  "pm.test('同一用户至少拥有两个空间', function () { pm.expect(records.length).to.be.at.least(2); });",
                  "pm.test('列表包含个人空间和第二空间', function () {",
                  "  pm.expect(containsId(records, pm.environment.get('workspaceId'))).to.eql(true);",
                  "  pm.expect(containsId(records, pm.environment.get('secondWorkspaceId'))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/workspaces",
              "host": [
                "{{baseurl}}/workspaces"
              ]
            }
          }
        },
        {
          "name": "默认具备 solution:write",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.test('业务码为 0', function () { pm.expect(body.code).to.eql(0); });",
                  "pm.test('包含 requestId', function () { pm.expect(body.requestId).to.be.ok; });",
