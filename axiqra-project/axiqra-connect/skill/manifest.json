{
  "name": "@axiqra/skill",
  "version": "1.0.0",
  "description": "Axiqra Agent Skill - AI 工程方案记忆层接入包",
  "type": "module",
  "author": "Axiqra Team",
  "license": "Apache-2.0",
  "homepage": "https://www.axiqra.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiqra/axiqra.git"
  },
  "keywords": [
    "engineering-memory",
    "ai-agent",
    "solution-library",
    "engineering-trace",
    "knowledge-base",
    "mcp",
    "cursor",
    "claude-code"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "RULES/",
    "manifest.json"
  ],
  "axiqra": {
    "protocol_version": "1.0.0",
    "capabilities": {
      "search": {
        "description": "任务前搜索历史方案",
        "tools": ["search_before_act", "get_solution", "get_public_case"],
        "permissions": ["search:read", "solution:read"]
      },
      "trace": {
        "description": "提交工程轨迹包",
        "tools": ["submit_trace", "get_trace"],
        "permissions": ["trace:write"]
      },
      "feedback": {
        "description": "提交调用反馈",
        "tools": ["submit_feedback"],
        "permissions": ["feedback:write"]
      },
      "seed": {
        "description": "创建候选种子",
        "tools": ["create_seed"],
        "permissions": ["search:admin"]
      },
      "doctor": {
        "description": "接入诊断",
        "tools": ["doctor"],
        "permissions": ["connect:write"]
      }
    },
    "integration": {
      "channels": ["cli", "mcp", "api"],
      "target_tools": ["cursor", "claude_code", "codex", "gemini_cli", "custom"],
      "protocols": ["mcp", "rest", "websocket"]
    },
    "limits": {
      "quota": {
        "daily": 2000,
        "window": "day",
        "reset_at": "UTC:00:00"
      },
      "rate_limit": {
        "requests": 100,
        "window_seconds": 60
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {},
  "devDependencies": {},
  "peerDependencies": {}
}
