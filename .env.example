# Copy this file to .env and fill in real credentials.
# Spring Boot does not read .env by itself; use tools/start-backend-cloud.ps1.

SPRING_PROFILES_ACTIVE=cloud

# Server
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8080
LOGGING_FILE_PATH=./logs/axiqra

# CockroachDB primary database
COCKROACH_DB_URL=jdbc:postgresql://<cluster-host>:26257/defaultdb?sslmode=require
COCKROACH_DB_USER=axiqra_app
COCKROACH_DB_PASSWORD=<cockroach-password>

# PostgreSQL audit database, for Neon/Supabase/etc.
AUDIT_DB_URL=jdbc:postgresql://<audit-host>:5432/<database>?sslmode=require
AUDIT_APP_DB_USER=<audit-user>
AUDIT_APP_DB_PASSWORD=<audit-password>

# Redis, for Upstash/Redis Cloud/etc.
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=<redis-password>
REDIS_SSL_ENABLED=true
REDIS_DATABASE=0

# RabbitMQ is optional for local cloud smoke tests.
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
MANAGEMENT_HEALTH_RABBIT_ENABLED=false

# Object storage, S3-compatible or local MinIO.
AXIQRA_ENABLE_MINIO=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=axiqra-evidence
MINIO_SECURE=false
AXIQRA_HEALTH_MINIO_URL=http://127.0.0.1:9000/minio/health/live

# Application secrets. Generate unique values per environment.
JWT_SECRET=<at-least-32-random-characters>
FIELD_ENCRYPT_KEY=<32-byte-or-compatible-random-secret>

# API signing can stay off while wiring cloud infrastructure.
AXIQRA_ENABLE_API_SIGNATURE=false
AXIQRA_ENABLE_RATE_LIMIT=true

# Alert webhook is optional.
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=
