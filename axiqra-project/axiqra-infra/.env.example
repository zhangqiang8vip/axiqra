# ===================== 环境 =====================
SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=UTC

# ===================== CockroachDB =====================
# 注意：--insecure 仅限本地开发使用。生产环境设置为空（使用 TLS）。
COCKROACH_INSECURE=--insecure
DB_PASSWORD=change_me_before_production

# ===================== PostgreSQL 审计库 =====================
AUDIT_DB_USER=axq_audit
AUDIT_DB_PASSWORD=change_me_before_production

# ===================== Redis =====================
REDIS_PASSWORD=change_me_before_production

# ===================== RabbitMQ =====================
RABBITMQ_DEFAULT_USER=axq_rabbit
RABBITMQ_DEFAULT_PASS=change_me_before_production
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_AMQP_PORT=5672

# ===================== MinIO（S1 预留） =====================
MINIO_ACCESS_KEY=change_me_before_production
MINIO_SECRET_KEY=change_me_before_production
# SSE-S3 服务端加密密钥（32 字节，base64 编码）
MINIO_SSE_S3_KEY=change_me_before_production_32bytes_key

# ===================== JWT =====================
JWT_SECRET=change_me_before_production_use_256bit_key_here

# ===================== 字段加密（AES-256-GCM） =====================
FIELD_ENCRYPT_KEY=change_me_before_production_32bytes
