  "version": "1.0.0",
  "description": "Axiqra Connect - 一键接入包",
  "type": "module",
  "main": "bin/axiqra-connect.js",
  "bin": {
    "axiqra": "./cli/scripts/axiqra-cli.mjs"
  },
